{
  "name": "neon-os",
  "productName": "Neon OS",
  "version": "1.1.0",
  "description": "A desktop of music apps in the Neon Orbit style",
  "author": { "name": "Madoromi", "email": "madoromitv@users.noreply.github.com" },
  "homepage": "https://madoromitv.github.io/neon-os/",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy": "node copy-app.js",
    "start": "node copy-app.js && electron .",
    "dist": "node copy-app.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "tv.madoromi.neonos",
    "productName": "Neon OS",
    "copyright": "Madoromi",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "fileAssociations": [
      { "ext": ["mp3", "flac", "wav", "ogg", "oga", "opus", "m4a", "aac"], "name": "Audio", "description": "Music", "role": "Viewer" }
    ],
    "win": { "target": ["nsis"], "artifactName": "Neon-OS-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }], "category": "public.app-category.music", "artifactName": "Neon-OS-${version}-${arch}.${ext}" },
    "linux": { "target": ["AppImage", "deb"], "category": "Audio", "artifactName": "Neon-OS-${version}.${ext}", "maintainer": "Madoromi <madoromitv@users.noreply.github.com>" }
  }
}
