{
  "name": "neon-os",
  "productName": "Neon OS",
  "version": "1.3.0",
  "description": "A desktop of music apps in the Neon Orbit style",
  "author": {
    "name": "Madoromi",
    "email": "madoromitv@users.noreply.github.com"
  },
  "homepage": "https://madoromitv.github.io/neon-os/",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy": "node copy-app.js",
    "start": "node copy-app.js && electron .",
    "dist": "node copy-app.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "tv.madoromi.neonos",
    "productName": "Neon OS",
    "copyright": "Madoromi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "app/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 audio",
        "description": "MP3 audio",
        "mimeType": "audio/mpeg",
        "role": "Viewer"
      },
      {
        "ext": "flac",
        "name": "FLAC audio",
        "description": "FLAC audio",
        "mimeType": "audio/flac",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "WAV audio",
        "description": "WAV audio",
        "mimeType": "audio/wav",
        "role": "Viewer"
      },
      {
        "ext": "ogg",
        "name": "Ogg audio",
        "description": "Ogg audio",
        "mimeType": "audio/ogg",
        "role": "Viewer"
      },
      {
        "ext": "oga",
        "name": "Ogg audio",
        "description": "Ogg audio",
        "mimeType": "audio/ogg",
        "role": "Viewer"
      },
      {
        "ext": "opus",
        "name": "Opus audio",
        "description": "Opus audio",
        "mimeType": "audio/opus",
        "role": "Viewer"
      },
      {
        "ext": "m4a",
        "name": "M4A audio",
        "description": "M4A audio",
        "mimeType": "audio/mp4",
        "role": "Viewer"
      },
      {
        "ext": "aac",
        "name": "AAC audio",
        "description": "AAC audio",
        "mimeType": "audio/aac",
        "role": "Viewer"
      },
      {
        "ext": "mp4",
        "name": "MP4 video",
        "description": "MP4 video",
        "mimeType": "video/mp4",
        "role": "Viewer"
      },
      {
        "ext": "m4v",
        "name": "M4V video",
        "description": "M4V video",
        "mimeType": "video/mp4",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WebM video",
        "description": "WebM video",
        "mimeType": "video/webm",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "MKV video",
        "description": "MKV video",
        "mimeType": "video/x-matroska",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "QuickTime video",
        "description": "QuickTime video",
        "mimeType": "video/quicktime",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Neon-OS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "artifactName": "Neon-OS-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "artifactName": "Neon-OS-${version}.${ext}",
      "maintainer": "Madoromi <madoromitv@users.noreply.github.com>"
    }
  }
}
